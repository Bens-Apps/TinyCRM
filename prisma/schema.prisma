generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js v5 / Prisma Adapter ───────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ────────────────────────────────────────────

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  preferences       Json               @default("{}")
  calendarConnected Boolean            @default(false)
  accounts          Account[]
  sessions          Session[]
  contacts          Contact[]
  journalEntries    JournalEntry[]
  areas             Area[]
  projects          Project[]
  tasks             Task[]
  activityLogs      ActivityLog[]
  relationshipTypes RelationshipType[]
  tags              Tag[]
}

model Contact {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  email              String?
  phone              String?
  linkedinUrl        String?
  company            String?
  tags               String?
  relationshipTypeId String?
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipType   RelationshipType? @relation(fields: [relationshipTypeId], references: [id], onDelete: SetNull)
  journalEntries     JournalEntry[]
  tasks              Task[]

  @@index([userId])
  @@index([userId, name])
  @@index([relationshipTypeId])
}

model RelationshipType {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts  Contact[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  contactId String?
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([contactId])
  @@index([userId, createdAt])
}

model Area {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?   @db.Text
  color       String?
  sortOrder   Int       @default(0)
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]
  tasks       Task[]

  @@unique([userId, name])
  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  areaId      String?
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([userId])
  @@index([areaId])
  @@index([userId, status])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  title         String
  description   String?      @db.Text
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(NONE)
  dueDate       DateTime?
  scheduledDate DateTime?
  completedAt   DateTime?
  tags          String?
  projectId     String?
  areaId        String?
  contactId     String?
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  area          Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, scheduledDate])
  @@index([projectId])
  @@index([areaId])
  @@index([contactId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  entityType  String
  entityId    String
  entityName  String
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, entityType])
}
